# Gradle / Android 构建产物
.gradle/
build/
app/build/
**/build/
captures/
.cxx/

# 本地配置（含 SDK 路径，不应提交）
local.properties

# IDE
.idea/
*.iml
.vscode/

# 系统文件
.DS_Store
Thumbs.db

# 日志
*.log

# Kotlin 缓存
.kotlin/
android-sdk/

# 构建产物（二进制包绝对不能入 git，严重污染仓库历史）
*.apk
*.aab
*.ap_
*.dex
*.aar

# 签名密钥（绝不能提交，会让任何人能伪造你的签名APK）
*.keystore
*.jks
*.p12
*.pfx
/signing.properties

# 发布目录
releases/*.apk
releases/*.aab

# Node.js 依赖（server/ 模块）
server/node_modules/
node_modules/

# SQLite 数据库（运行时数据，不入仓库）
*.db
*.db-shm
*.db-wal
server/src/data/

# 上传文件（用户付款截图、语音）
server/public/uploads/

# 部署生成的密钥文件
server/.env
deploy/.env.local

# IDE 工具产物
.trae-html-share-packages/

# ngrok token
.ngrok_token

# 临时验证产物
/tmp/
