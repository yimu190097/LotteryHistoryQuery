<?xml version="1.0" encoding="utf-8"?>
<!-- 语音通话客服：模拟呼叫/通话中。少图标、多文字，适合老年用户 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#1F1F1F"
    android:padding="24dp">

    <!-- 客服标识：文字"客服"圆形头像 -->
    <TextView
        android:id="@+id/tvAvatarText"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:gravity="center"
        android:text="客服"
        android:textColor="@android:color/white"
        android:textSize="32sp"
        android:textStyle="bold"
        android:background="@drawable/bg_avatar_circle"
        android:backgroundTint="#3D5AFE" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="在线客服"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="正在呼叫..."
        android:textColor="#B3FFFFFF"
        android:textSize="@dimen/title_text_size" />

    <TextView
        android:id="@+id/tvDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="00:00"
        android:textColor="@android:color/white"
        android:textSize="32sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:visibility="gone" />

    <!-- 通话中功能按钮（呼叫中隐藏） -->
    <LinearLayout
        android:id="@+id/llCallActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone">

        <!-- 静音：文字按钮 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/btnMute"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_call_btn_circle"
                android:text="静音"
                android:textColor="@android:color/white"
                android:textSize="@dimen/body_text_size"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 免提：文字按钮 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/btnSpeaker"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_call_btn_circle"
                android:text="免提"
                android:textColor="@android:color/white"
                android:textSize="@dimen/body_text_size"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 挂断按钮：圆形红底文字按钮 -->
    <TextView
        android:id="@+id/btnHangup"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="60dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_hangup_circle"
        android:text="挂断"
        android:textColor="@android:color/white"
        android:textSize="@dimen/title_text_size"
        android:textStyle="bold" />

</LinearLayout>
