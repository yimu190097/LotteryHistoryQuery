<?xml version="1.0" encoding="utf-8"?>
<!-- 使用 NestedScrollView，确保在外层 CoordinatorLayout+AppBarLayout 中可以协同滚动（吸顶Tab生效） -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingEnd="@dimen/page_padding"
        android:paddingTop="@dimen/page_padding"
        android:paddingBottom="@dimen/page_padding">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/card_margin"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/card_padding"
                android:paddingEnd="@dimen/card_padding"
                android:paddingTop="@dimen/card_padding"
                android:paddingBottom="@dimen/card_padding">

                <TextView
                    android:id="@+id/tvPrimaryLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary_red"
                    android:textStyle="bold"
                    android:textSize="@dimen/title_text_size"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/tvPrimarySelected"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primary_red"
                        android:textSize="@dimen/small_text_size" />
                </LinearLayout>

                <!-- 已选号码球：自适应换行，全部可见不重叠 -->
                <com.lottery.history.widget.FlowLayout
                    android:id="@+id/llPrimarySelectedBalls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:clipChildren="false"
                    android:clipToPadding="false" />

                <TextView
                    android:id="@+id/tvPrimaryTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="@dimen/body_text_size" />

                <GridLayout
                    android:id="@+id/gridPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">
                </GridLayout>

                <!-- 后区（单区彩种时整个隐藏） -->
                <LinearLayout
                    android:id="@+id/secondarySection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:id="@+id/tvSecondarySelected"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/primary_blue"
                            android:textSize="@dimen/small_text_size" />
                    </LinearLayout>

                    <!-- 后区已选号码球：自适应换行 -->
                    <com.lottery.history.widget.FlowLayout
                        android:id="@+id/llSecondarySelectedBalls"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:clipChildren="false"
                        android:clipToPadding="false" />

                    <TextView
                        android:id="@+id/tvSecondaryTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="@dimen/body_text_size" />

                    <GridLayout
                        android:id="@+id/gridSecondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">
                    </GridLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btnReset"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_button_gray"
                        android:text="@string/reset"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/body_text_size" />

                    <Button
                        android:id="@+id/btnQuery"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_button_red"
                        android:text="@string/query"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/body_text_size" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/card_padding"
                android:paddingEnd="@dimen/card_padding"
                android:paddingTop="@dimen/card_padding"
                android:paddingBottom="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/query_result"
                        android:textAlignment="center"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/title_text_size" />

                    <TextView
                        android:id="@+id/btnQueryHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_btn_history"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="查询历史"
                        android:textColor="@color/primary_red"
                        android:textSize="@dimen/small_text_size"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSelectedNumbers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="4dp"
                    android:textSize="@dimen/small_text_size" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="6dp">

                    <!-- 前区/主号码结果行：标签 + 自适应换行球 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="2dp">

                        <TextView
                            android:id="@+id/tvResultPrimaryLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/red_ball"
                            android:textSize="@dimen/small_text_size"
                            android:textStyle="bold"
                            android:layout_marginEnd="4dp" />

                        <com.lottery.history.widget.FlowLayout
                            android:id="@+id/llResultRedBalls"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clipChildren="false"
                            android:clipToPadding="false" />
                    </LinearLayout>

                    <!-- 后区/次号码结果行（单区彩种时隐藏） -->
                    <LinearLayout
                        android:id="@+id/llResultSecondaryRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:id="@+id/tvResultSecondaryLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/blue_ball"
                            android:textSize="@dimen/small_text_size"
                            android:textStyle="bold"
                            android:layout_marginEnd="4dp" />

                        <com.lottery.history.widget.FlowLayout
                            android:id="@+id/llResultBlueBalls"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clipChildren="false"
                            android:clipToPadding="false" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/divider" />

                <!-- 表头：奖项名称 / 命中红球 / 命中蓝球 / 命中次数 / 操作 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/bg_table_header">

                    <TextView
                        android:id="@+id/tvHeaderPrizeName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.3"
                        android:text="奖项"
                        android:gravity="center"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/small_text_size" />

                    <TextView
                        android:id="@+id/tvHeaderHitPrimary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.1"
                        android:text="命中红球"
                        android:gravity="center"
                        android:textStyle="bold"
                        android:textColor="@color/red_ball"
                        android:textSize="@dimen/small_text_size" />

                    <TextView
                        android:id="@+id/tvHeaderHitSecondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.1"
                        android:text="命中蓝球"
                        android:gravity="center"
                        android:textStyle="bold"
                        android:textColor="@color/blue_ball"
                        android:textSize="@dimen/small_text_size" />

                    <TextView
                        android:id="@+id/tvHeaderCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.9"
                        android:text="次数"
                        android:gravity="center"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/small_text_size" />

                    <TextView
                        android:id="@+id/tvHeaderAction"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.1"
                        android:text="操作"
                        android:gravity="center"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/small_text_size" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/divider" />

                <!-- 中奖结果：使用权重分配列宽，自动适配屏幕宽度，无需横向滚动 -->
                <LinearLayout
                    android:id="@+id/resultContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
