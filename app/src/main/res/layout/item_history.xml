<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- 规则版本分组标题（仅每组第一期显示，其他期GONE） -->
    <TextView
        android:id="@+id/tvRuleSectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@drawable/bg_policy_section_header"
        android:textColor="#1B5E20"
        android:textSize="@dimen/small_text_size"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 顶部：序号 + 期号 + 日期 + 政策标签，一行展示，文字大小按所在行信息综合考虑 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="3dp">

        <TextView
            android:id="@+id/tvIndex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="18dp"
            android:textAlignment="center"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/micro_text_size" />

        <TextView
            android:id="@+id/tvIssue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/small_text_size"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:ellipsize="none" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/micro_text_size"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- 政策标签徽章：每期显示，提示该期适用的规则版本（防止不同期规则混排困惑） -->
        <TextView
            android:id="@+id/tvPolicyBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_policy_badge"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="#1B5E20"
            android:textSize="@dimen/micro_text_size"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 命中情况标签：命中红球N个 + 命中蓝球N个（仅当选号存在时显示） -->
    <LinearLayout
        android:id="@+id/llHitSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="3dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvHitPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/micro_text_size"
            android:textStyle="bold"
            android:background="@drawable/bg_chip_red"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginEnd="4dp"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/tvHitSecondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/micro_text_size"
            android:textStyle="bold"
            android:background="@drawable/bg_chip_blue"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <!-- 追加投注命中情况（仅大乐透等有追加玩法的彩种显示） -->
    <TextView
        android:id="@+id/tvAppendInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:textSize="@dimen/micro_text_size"
        android:textColor="#E65100"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 号码球：自适应换行，红球/蓝球全部可见不重叠 -->
    <com.lottery.history.widget.FlowLayout
        android:id="@+id/llNumbers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false" />

    <!-- 查看当期开奖详情按钮：仅当选号存在时显示 -->
    <TextView
        android:id="@+id/btnViewDrawDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/bg_button_red_small"
        android:clickable="true"
        android:focusable="true"
        android:text="查看当期所有奖项"
        android:textColor="@android:color/white"
        android:textSize="@dimen/micro_text_size"
        android:textStyle="bold" />

</LinearLayout>
